{
  "name": "@markettec/ms-catalog",
  "version": "0.1.0",
  "private": true,
  "description": "MarketTec catalog service foundation",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "start": "node dist/src/server.js",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "test:cosmos": "npm run build && node --test dist/tests/cosmos.integration.js",
    "check": "npm run typecheck && npm test"
  },
  "dependencies": {
    "@azure/cosmos": "4.10.2",
    "express": "5.3.0"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
