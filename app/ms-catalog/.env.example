PORT=3000
SERVICE_NAME=ms-catalog
LOG_LEVEL=info

# Publicaciones autenticadas con persistencia Cosmos. Completar las variables
# del entorno antes de activar. Usa solo una fuente de claves JWT.
# CATALOG_PUBLICATIONS_STORE=cosmos
# CATALOG_JWT_ISSUER=
# CATALOG_JWT_AUDIENCE=
# CATALOG_JWT_JWKS_URI=
# CATALOG_JWT_JWKS_JSON=
# In Azure staging, inject the APIM backend key from secure configuration.
# CATALOG_APIM_BACKEND_KEY=
# CATALOG_USERS_PROFILE_URL=
# CATALOG_PLACEHOLDER_IMAGE_URL=
# CATALOG_COSMOS_ENDPOINT=
# CATALOG_COSMOS_DATABASE=
# CATALOG_COSMOS_PUBLICATIONS_CONTAINER=publicaciones
# CATALOG_COSMOS_CHATS_CONTAINER=chats
# CATALOG_COSMOS_MESSAGES_CONTAINER=mensajes
# Sin clave, el SDK usa Managed Identity. Para una identidad asignada por el usuario:
# CATALOG_COSMOS_MANAGED_IDENTITY_CLIENT_ID=
# Para emulador o entorno autorizado con clave externa:
# CATALOG_COSMOS_KEY=

# MTEC-31. Use the same pre-provisioned queue configured in ms-notifications.
# Requires Cosmos storage and the /outboxAvailableAt/? index in the messages container.
# CATALOG_MESSAGE_QUEUE_URL=https://<account>.queue.core.windows.net/<queue>
# Optional: select a user-assigned managed identity for Queue.
# CATALOG_MESSAGE_QUEUE_MANAGED_IDENTITY_CLIENT_ID=
