{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://markettec.local/contracts/events/common-event-envelope.schema.json",
  "title": "MarketTecEventEnvelope",
  "description": "Borrador común para eventos internos; pendiente de aprobación.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "eventId",
    "eventType",
    "schemaVersion",
    "occurredAt",
    "producer",
    "correlationId",
    "payload"
  ],
  "properties": {
    "eventId": {
      "type": "string",
      "format": "uuid"
    },
    "eventType": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "schemaVersion": {
      "type": "integer",
      "minimum": 1
    },
    "occurredAt": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9999999999,
      "description": "Epoch UNIX en segundos; valores en milisegundos son inválidos."
    },
    "producer": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "correlationId": {
      "type": "string",
      "format": "uuid"
    },
    "payload": {
      "type": "object"
    }
  }
}
