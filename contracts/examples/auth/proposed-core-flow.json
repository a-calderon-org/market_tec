{
  "$comment": "PROPOSED behavior for the coordinated core increment (Google -> attempt/nonce -> credential exchange -> internal JWT -> session bootstrap -> profile -> refresh rotate -> logout current). Nothing here is approved or implemented. Every item points to an open decision in docs/MTEC15_B07_DECISION_REGISTER.md. contracts/tests/test_b07_reconciliation.py checks that it only uses operations and status codes the OpenAPI declares, that it never calls blocked operations, and that it does not use web storage.",
  "kind": "proposed",
  "approved": false,
  "contractVersion": "0.3.0-draft",
  "storagePolicy": {
    "accessToken": "memory",
    "csrfToken": "memory",
    "refreshToken": "httponly-cookie-managed-by-browser",
    "authenticatedUser": "memory",
    "googleCredential": "never-stored",
    "localStorage": [],
    "sessionStorage": [],
    "indexedDb": [],
    "decision": "D-01"
  },
  "credentialsPolicy": {
    "withCredentialsRoutes": ["/v1/auth/attempts", "/v1/auth/google", "/v1/auth/session", "/v1/auth/refresh", "/v1/auth/logout"],
    "bearerRoutes": ["/v1/me/profile", "/v1/usuarios/{userId}"],
    "neverSendBearerTo": ["/v1/auth/attempts", "/v1/auth/google", "/v1/auth/session", "/v1/auth/refresh", "/v1/auth/logout", "/.well-known/jwks.json", "/.well-known/markettec-identity"],
    "apimSubscriptionKeyFromSpa": false,
    "requiredHeaders": {"authPosts": ["X-MTEC-Client: web", "Content-Type: application/json"], "csrfRoutes": ["X-CSRF-Token"]},
    "decision": "D-04"
  },
  "operationsCalledByAngular": ["createAuthenticationAttempt", "exchangeGoogleCredential", "getSessionState", "refreshSession", "logoutSession", "getOwnUserProfile", "updateOwnUserProfile"],
  "operationsAngularMustNotCall": {
    "recordSessionActivity": "D-03",
    "createMethodProofAttempt": "D-14",
    "verifyGoogleMethodProof": "D-14",
    "requestEmailMethodProof": "D-14",
    "verifyEmailMethodProof": "D-14",
    "linkOwnAuthMethod": "D-14",
    "getOwnAuthMethods": "D-14",
    "requestInstitutionalEmailLink": "D-02",
    "confirmInstitutionalEmailLink": "D-02",
    "legacyGoogleRegistrationCompatibility": "D-06"
  },
  "unsupportedParameters": {
    "refreshSession": {"mode": ["continue"], "decision": "D-10"},
    "logoutSession": {"scope": ["all"], "decision": "D-10"}
  },
  "flows": {
    "login": {
      "decision": "D-06",
      "steps": [
        {"n": 1, "actor": "angular", "call": "createAuthenticationAttempt", "body": {"method": "google", "purpose": "login"}, "expect": 200, "keep": ["attemptId", "csrfToken", "nonce", "expiresAt"]},
        {"n": 2, "actor": "angular", "action": "google.accounts.id.initialize({client_id, nonce, callback}) then renderButton", "note": "The nonce from step 1 must be in initialize; a new attempt requires a new initialize."},
        {"n": 3, "actor": "google", "action": "callback(credential)"},
        {"n": 4, "actor": "angular", "call": "exchangeGoogleCredential", "headers": {"X-CSRF-Token": "<attempt csrfToken>"}, "body": {"attemptId": "<step 1>", "credential": "<step 3>"}, "expect": 200, "keep": ["token", "csrfToken", "user.userId", "session"]},
        {"n": 5, "actor": "angular", "action": "discard credential and attempt csrfToken; store token, csrfToken, user, session in memory; schedule refresh from session and token exp"},
        {"n": 6, "actor": "angular", "call": "getOwnUserProfile", "headers": {"Authorization": "Bearer <token>"}, "expect": 200}
      ]
    },
    "register": {
      "decision": "D-06",
      "steps": [
        {"n": 1, "actor": "angular", "call": "createAuthenticationAttempt", "body": {"method": "google", "purpose": "register"}, "expect": 200, "unavailableStatus": 503},
        {"n": 2, "actor": "angular", "call": "exchangeGoogleCredential", "note": "same call as login; the server's stored purpose decides"}
      ]
    },
    "reload": {
      "decision": "D-01",
      "steps": [
        {"n": 1, "actor": "angular", "action": "memory is empty after reload"},
        {"n": 2, "actor": "angular", "call": "getSessionState", "expect": 200, "keep": ["csrfToken", "user", "session"], "onStatus": {"401": "unauthenticated: go to /login, no retry"}},
        {"n": 3, "actor": "angular", "call": "refreshSession", "body": {"mode": "rotate"}, "headers": {"X-CSRF-Token": "<step 2 csrfToken>"}, "expect": 200, "keep": ["token", "csrfToken"], "note": "inside the cross-tab lock"}
      ]
    },
    "scheduledRefresh": {
      "decision": "D-07",
      "trigger": "token exp minus a margin chosen by Angular, never after session.expiresAt",
      "steps": [
        {"n": 1, "actor": "angular", "action": "acquire lock mtec-refresh (Web Locks, fallback BroadcastChannel lock)"},
        {"n": 2, "actor": "angular", "call": "getSessionState", "note": "take the csrfToken currently valid for the cookie; another tab may have rotated"},
        {"n": 3, "actor": "angular", "call": "refreshSession", "body": {"mode": "rotate"}, "expect": 200},
        {"n": 4, "actor": "angular", "action": "store token and csrfToken in memory; release lock; broadcast only a 'rotated' signal without credentials"}
      ]
    },
    "lostResponse": {
      "decision": "D-07",
      "steps": [
        {"n": 1, "actor": "angular", "action": "refreshSession failed with network error or timeout: do not repeat the same request"},
        {"n": 2, "actor": "angular", "call": "getSessionState", "onStatus": {"200": "session alive with the cookie held by the browser: use the returned csrfToken and perform at most one new rotate when a token is next needed", "401": "the cookie was consumed or is missing: reauthenticate (policy C, no grace)"}}
      ]
    },
    "loserTab": {
      "decision": "D-07",
      "steps": [
        {"n": 1, "actor": "angular", "action": "refreshSession answered 401 REFRESH_INVALID"},
        {"n": 2, "actor": "angular", "call": "getSessionState", "onStatus": {"200": "another tab won; keep the session open and take the new csrfToken", "401": "reauthenticate"}}
      ]
    },
    "businessCall401": {
      "decision": "D-11",
      "steps": [
        {"n": 1, "actor": "angular", "action": "business request answered 401 AUTH_REQUIRED while holding a token believed valid"},
        {"n": 2, "actor": "angular", "action": "run scheduledRefresh once; retry the original request once with the new token"},
        {"n": 3, "actor": "angular", "action": "if the retry answers 401 again: clear memory and reauthenticate; no further automatic retries"}
      ]
    },
    "logout": {
      "decision": "D-12",
      "steps": [
        {"n": 1, "actor": "angular", "call": "logoutSession", "body": {"scope": "current"}, "headers": {"X-CSRF-Token": "<session csrfToken>"}, "expect": 204},
        {"n": 2, "actor": "angular", "action": "clear memory regardless of the answer; sign out of GIS (disableAutoSelect); navigate to /login"},
        {"n": 3, "actor": "angular", "note": "204 proves revocation in ms-users only; an already issued access JWT stays valid until exp (<=240 s)"}
      ]
    }
  },
  "errorMap": {
    "INVALID_REQUEST": {"http": [400], "action": "show-generic-error", "retry": false},
    "AUTH_PROOF_INVALID": {"http": [401], "action": "show-generic-auth-error", "retry": false, "note": "also returned for an unknown Google identity today (M-06)"},
    "UNAUTHORIZED": {"http": [401], "action": "reauthenticate", "retry": false, "note": "documented, never emitted by Java"},
    "AUTH_REQUIRED": {"http": [401], "action": "businessCall401", "retry": "once", "note": "Java code outside the OpenAPI enum (M-19)"},
    "ACCESS_TOKEN_EXPIRED": {"http": [401], "action": "businessCall401", "retry": "once", "note": "documented, never emitted by Java"},
    "SESSION_EXPIRED": {"http": [401], "action": "reauthenticate", "retry": false, "note": "documented, never emitted by Java"},
    "SESSION_REVOKED": {"http": [401], "action": "reauthenticate", "retry": false, "note": "documented, never emitted by Java"},
    "REFRESH_INVALID": {"http": [401], "action": "loserTab", "retry": false},
    "FORBIDDEN": {"http": [403], "action": "show-forbidden", "retry": false},
    "CSRF_INVALID": {"http": [403], "action": "restart-attempt", "retry": false},
    "ORIGIN_DENIED": {"http": [403], "action": "show-configuration-error", "retry": false},
    "ELIGIBILITY_DENIED": {"http": [403], "action": "show-domain-not-eligible", "retry": false, "note": "documented, never emitted by Java"},
    "REAUTHENTICATION_REQUIRED": {"http": [403], "action": "blocked-until-D-14", "retry": false},
    "ATTEMPT_CONSUMED": {"http": [409], "action": "restart-attempt", "retry": false},
    "IDENTITY_CONFLICT": {"http": [409], "action": "show-generic-auth-error", "retry": false},
    "CONTINUITY_REQUIRED": {"http": [409], "action": "blocked-until-D-02", "retry": false},
    "REGISTRATION_REQUIRED": {"http": [409], "action": "offer-register", "retry": false, "note": "documented, never emitted by Java (D-06)"},
    "ACTIVITY_NOT_ACCEPTED": {"http": [409], "action": "none", "retry": false, "note": "blocked (D-03)"},
    "RESOURCE_NOT_FOUND": {"http": [404], "action": "show-not-found", "retry": false, "note": "documented, never emitted by Java"},
    "ATTEMPT_EXPIRED": {"http": [410], "action": "restart-attempt", "retry": false},
    "RATE_LIMITED": {"http": [429], "action": "backoff-with-Retry-After", "retry": "after", "note": "documented, never emitted by Java; expected from APIM"},
    "AUTH_TEMPORARILY_UNAVAILABLE": {"http": [503], "action": "show-unavailable", "retry": "manual"},
    "ACTIVITY_EVIDENCE_REQUIRED": {"http": [403], "action": "none", "retry": false, "note": "Java code outside the enum; never called by Angular"},
    "INSTITUTIONAL_EMAIL_REQUIRED": {"http": [400], "action": "none", "retry": false, "note": "Java code outside the enum; email is off"},
    "USER_NOT_FOUND": {"http": [404], "action": "reauthenticate", "retry": false, "note": "Java code outside the enum"},
    "USER_DEACTIVATED": {"http": [403], "action": "show-account-disabled", "retry": false, "note": "Java code outside the enum"},
    "CONCURRENT_MODIFICATION": {"http": [409], "action": "reload-profile", "retry": false, "note": "Java code outside the enum"},
    "INTERNAL_ERROR": {"http": [500], "action": "show-generic-error", "retry": false, "note": "Java code outside the enum"},
    "ROUTE_NOT_FOUND": {"http": [404], "action": "show-generic-error", "retry": false, "note": "Java code outside the enum"},
    "METHOD_NOT_ALLOWED": {"http": [405], "action": "show-generic-error", "retry": false, "note": "Java code outside the enum"}
  },
  "unknownErrorCodePolicy": "show-generic-error; never fall back to a Google identity or keep a stale session",
  "releaseGates": {
    "angularFeatureFlag": {"name": "authCoreV2", "default": false, "owner": "angular"},
    "msUsersFlagsRequiredOnlyInTestEnvironments": [
      "users.google.enabled", "users.google.login-enabled", "users.google.http.enabled", "users.internal-jwt.enabled",
      "users.session.http.enabled", "users.session.refresh.enabled", "users.session.logout.enabled", "users.api.http.enabled"
    ],
    "msUsersFlagsThatMustStayOff": ["users.email.enabled", "users.auth-methods.linking.enabled"],
    "msUsersFlagsDecidedByRp": ["users.google.registration.enabled"],
    "topologyFlagsRequireEvidence": ["users.google.http.same-site-verified", "users.session.http.https-topology-verified"],
    "apimApprovalsRemainNull": ["abuse_protection", "ms_users_contract"]
  }
}
