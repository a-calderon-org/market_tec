      "note": "Java code outside the enum"
    },
    "METHOD_NOT_ALLOWED": {
      "http": [
        405
      ],
      "action": "show-generic-error",
      "retry": false,
      "note": "Java code outside the enum"
    }
  },
  "unknownErrorCodePolicy": "show-generic-error; never fall back to a Google identity or keep a stale session",
  "releaseGates": {
    "angularFeatureFlag": {
      "name": "authCoreV2",
      "default": false,
      "owner": "angular"
    },
    "msUsersFlagsRequiredOnlyInTestEnvironments": [
      "users.google.enabled",
      "users.google.login-enabled",
      "users.google.http.enabled",
      "users.internal-jwt.enabled",
      "users.session.http.enabled",
      "users.session.refresh.enabled",
      "users.session.logout.enabled",
      "users.api.http.enabled"
    ],
    "msUsersFlagsThatMustStayOff": [
      "users.email.enabled",
      "users.auth-methods.linking.enabled"
    ],
    "msUsersFlagsDecidedByRp": [
      "users.google.registration.enabled"
    ],
    "topologyFlagsRequireEvidence": [
      "users.google.http.same-site-verified",
      "users.session.http.https-topology-verified"
    ],
    "apimApprovalsRemainNull": [
      "abuse_protection",
      "ms_users_contract"
    ]
  },
  "decisionStatus": {
    "D-07": {
      "status": "design-policy-approved",
      "approvedOn": "2026-11-07",
      "approvedScope": "cross-tab refresh serialization and lost-response reconciliation as a design policy",
      "stillPending": [
        "Angular implementation",
        "cross-tab coordination tests in the supported browsers",
        "Angular, ms-users and security conformities",
        "B07 contract approval"
      ]
    },
    "D-11": {
      "status": "partially-approved",
      "approvedOn": "2026-11-07",
      "approvedScope": "no automatic replay of any business request after a 401 (GET and all mutations)",
      "stillPending": [
        "error code catalog: new Java codes and OpenAPI enum",
        "ACCESS_TOKEN_EXPIRED signal",
        "new public DTOs",
        "OpenAPI semantics",
        "future per-operation retries",
        "Angular, ms-users and security conformities",
        "B07 contract approval"
      ]
    }
  },
  "criticalSection": {
    "decision": "D-07",
    "status": "design-policy-approved-2026-11-07",
    "mutex": "cross-tab mutual exclusion with Web Locks (navigator.locks); BroadcastChannel only for signals, never as the mutex",
    "approvedMechanism": "web-locks",
    "mutualExclusionRequiredBeforeRotation": true,
    "withoutGuaranteedMutualExclusion": {
      "condition": "Web Locks unavailable and no equivalent mutual exclusion demonstrated",
      "action": "secure-reauthentication",
      "refreshPostsAllowed": 0,
      "automaticRotationAllowed": false,
      "broadcastChannelSubstitutesMutex": false
    },
    "covers": [
      "bootstrap",
      "refresh",
      "apply-result-to-memory"
    ],
    "csrfObtainedInside": true,
    "maxRefreshPostsPerDemand": 1,
    "maxRefreshInFlightPerTab": 1,
    "postFailureAction": "GET /v1/auth/session to reconcile state only; never chain another POST automatically",
    "logoutCoordination": "logout cancels pending refresh and restores and marks the local session closed so a late restore cannot reinstate credentials",
    "sessionGet200Proves": "current validity of the cookie only; not a rotation and not the issuance of an access JWT",
    "shareCredentialsBetweenTabs": false
  },
  "retryPolicy": {
    "decision": "D-11",
    "status": "initial-retry-policy-approved-2026-11-07",
    "genericReplayAllowed": false,
    "automaticReplayAfter401": {
      "GET": false,
      "POST": false,
      "PUT": false,
      "PATCH": false,
      "DELETE": false
    },
    "mutationsExcluded": [
      "PUT /v1/me/profile",
      "PUT /v1/usuarios/{userId}"
    ],
    "getRetry": {
      "allowed": false,
      "maxAttempts": 0
    },
    "futurePerOperationRetries": "pending-not-approved",
    "retryAfterAuthorizesRefresh": false
  },
  "angularErrorParsing": {
    "decision": "D-11",
    "status": "proposed-pending-approval",
    "note": "part of the D-11 error catalog, which is not covered by the 2026-11-07 approval of the initial retry policy",
    "codePath": "error.error?.error?.code",
    "cases": {
      "networkOrCors": "status === 0 and no body",
      "unauthorized": "status 401",
      "forbidden": "status 403",
      "unexpectedEnvelope": "body absent, not an object, or error.code not a string"
    },
    "unexpectedEnvelopeAction": "show-generic-error"
  }
}
